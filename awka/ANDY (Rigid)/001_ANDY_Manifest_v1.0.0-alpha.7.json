      "terminal_or_terminal_like_states": [
        "CLOSED",
        "BLOCKED"
      ],
      "alpha_7_progression_rule": "ADVANCE_STAGE must either prepare the next linear stage and return to STAGE_READY, or transition to WORKFLOW_COMPLETE when the final stage is advanced.",
      "finalization_rule": "FINALIZE_WORKFLOW requires WORKFLOW_COMPLETE unless an explicitly declared compatibility exception exists.",
      "blocked_state_rule": "BLOCKED must be either a true graph state with entry and recovery semantics, or represented as workflow_status=blocked while current_state remains unchanged. Alpha.7 must choose one."
